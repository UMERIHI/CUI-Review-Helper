{
  "manifest_version": 3,
  "name": "CU Feedback Helper",
  "version": "1.0",
  "description": "Auto-fill teacher or course feedback on CUOnline.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://lhr-sis.comsats.edu.pk/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://lhr-sis.comsats.edu.pk/Feedback/Survey/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CU Feedback Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
